{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:3000",
    "https://aisam.io.vn",
    "https://www.aisam.io.vn"
  ],
  "VideoProviderSettings": {
    "Enabled": false,
    "GeminiModel": "google/veo-3.1-fast",
    "GeminiTimeoutSeconds": 60,
    "OpenRouterModel": "minimax/video-01",
    "EnableColabFallback": true,
    "PollenTimeoutSeconds": 30,
    "DefaultSegmentCount": 3,
    "PollingIntervalSeconds": 15,
    "TimeoutMinutes": 30,
    "DeApiNotFoundMaxRetries": 3,
    "DeApiNotFoundRetryDelaySeconds": 30
  }
}
