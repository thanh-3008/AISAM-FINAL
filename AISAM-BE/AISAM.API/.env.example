CONNECTION_STRING=Host=localhost;Port=5432;Database=aisam;Username=postgres;Password=123456789;

# Required for Phase A auth/profile/brand/product APIs
JWT_SECRET_KEY=replace-with-a-long-random-secret-minimum-32-characters
JWT_ISSUER=AISAM.API
JWT_AUDIENCE=AISAM.Client
# Persistent key ring used to encrypt social access tokens.
DATA_PROTECTION_KEYS_PATH=.keys
FRONTEND_BASE_URL=http://localhost:3000

# Optional in Phase A. If SMTP is empty, email methods log and return without sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=

# Optional until Google login is tested
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional for API startup, required for Facebook OAuth and Page publishing
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=
FACEBOOK_GRAPH_API_VERSION=v23.0
FACEBOOK_BASE_URL=https://graph.facebook.com
FACEBOOK_OAUTH_URL=https://www.facebook.com

# Instagram Professional through Meta Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://your-ngrok-domain.ngrok-free.dev/auth/instagram/callback
INSTAGRAM_GRAPH_API_VERSION=v23.0
INSTAGRAM_BASE_URL=https://graph.facebook.com
INSTAGRAM_OAUTH_URL=https://www.facebook.com

# Optional for API startup, required for TikTok Login Kit OAuth
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok Web Login Kit requires an absolute HTTPS redirect URI registered in Developer Portal.
# For local development, point this to the ngrok FE callback. The FE callback
# relays the browser back to TIKTOK_LOCAL_CALLBACK_URL on localhost.
TIKTOK_REDIRECT_URI=https://your-ngrok-domain.ngrok-free.app/social-callback/tiktok
TIKTOK_OAUTH_URL=https://www.tiktok.com/v2/auth/authorize/
TIKTOK_API_BASE_URL=https://open.tiktokapis.com
TIKTOK_REQUIRED_SCOPES=user.info.basic,video.publish
# Unaudited TikTok apps must use SELF_ONLY.
TIKTOK_DEFAULT_PRIVACY_LEVEL=SELF_ONLY
# Comma-separated hosts from which the API may download videos for FILE_UPLOAD.
TIKTOK_ALLOWED_MEDIA_HOSTS=res.cloudinary.com
TIKTOK_MAX_UPLOAD_SIZE_MB=128

# Optional for API startup, required for AI text endpoints
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=2048
GEMINI_TEMPERATURE=0.7

# Optional for payment checkout APIs
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=

# AI Video Generation Config
VIDEO_ENABLED=true
VIDEO_GEMINI_KEY=
VIDEO_OPENROUTER_KEY=
VIDEO_OPENROUTER_MODEL=ltx-2
VIDEO_OPENROUTER_BASE_URL=https://pollo.ai/api/platform

# AI Image Generation Config
IMAGE_GEMINI_KEY=
IMAGE_GEMINI_MODEL=imagen-3.0-generate-002
IMAGE_OPENROUTER_KEY=
IMAGE_OPENROUTER_MODEL=bytedance-seed/seedream-4.5
IMAGE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/images
# Optional image-to-image/reference-image endpoint. For deAPI, set BASE_URL to
# https://api.deapi.ai/api/v2/images/generations and the edit URL is inferred.
IMAGE_OPENROUTER_EDIT_MODEL=QwenImageEdit_Plus_NF4
IMAGE_OPENROUTER_EDIT_BASE_URL=
IMAGE_OPENROUTER_EDIT_POLLING_INTERVAL_SECONDS=5
IMAGE_OPENROUTER_EDIT_TIMEOUT_MINUTES=10
IMAGE_HUGGINGFACE_KEY=
IMAGE_HUGGINGFACE_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_HUGGINGFACE_BASE_URL=https://router.huggingface.co/hf-inference/models/

# Deferred beyond Phase A. Avatar/product file uploads remain disabled in the MVP backend.
# SUPABASE_URL=
# SUPABASE_KEY=

# === Beeknoee AI Media API (Phương án 1 — sync-first) ===
# Đặt key vào đây hoặc biến môi trường production. KHÔNG commit key thật.
BEEKNOEE_BASE_URL=https://platform.beeknoee.com
BEEKNOEE_API_KEY=
# Model ảnh mặc định (gemini-3-pro-image-preview = $0.134/ảnh 1K).
# Các model rẻ hơn: gpt-image-1-mini ($0.005), grok-imagine ($0.025), gemini-2.5-flash-image ($0.039).
BEEKNOEE_IMAGE_MODEL=gemini-3-pro-image-preview
BEEKNOEE_TIMEOUT_SECONDS=120

# Video: model, duration mặc định
# veo-3.1-fast-generate-preview = $0.15/s × 8s = $1.20/video (✅ default)
# veo-3.1-generate-preview      = $0.40/s × 8s = $3.20/video (chất lượng cao hơn)
# sora-2                        = $0.10/s × 8s = $0.80/video (max 20s)
# seedance-2-fast               = $0.08/s × 8s = $0.64/video (rẻ nhất)
BEEKNOEE_VIDEO_MODEL=veo-3.1-fast-generate-preview
BEEKNOEE_VIDEO_DURATION=8
BEEKNOEE_VIDEO_RESOLUTION=720p
